---
/**
 * Shared document shell for every page: head metadata (via SeoHead),
 * global styles, hero slot, main content, and footer.
 *
 * Analytics deviation from the legacy site (prompt 04): GA4 is no longer
 * loaded unconditionally — GoogleAnalytics renders nothing until the team
 * opts in via siteConfig.analytics (src/data/site.ts).
 */
import GoogleAnalytics from "../components/seo/GoogleAnalytics.astro";
import SeoHead from "../components/seo/SeoHead.astro";
import type { SeoProps } from "../components/seo/SeoHead.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import { localAssets } from "../data/local-assets";
import { siteConfig } from "../data/site";
import "../styles/global.css";

interface Props {
  seo: SeoProps;
  theme?: "default" | "minecraft";
}

const { seo, theme = "default" } = Astro.props;
const headerLogo =
  theme === "minecraft" ? localAssets.geuLogoPixel : localAssets.geLogoBig;
---

<!doctype html>
<html lang={seo.lang ?? siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="preload" as="image" href={headerLogo} />
    <SeoHead {...seo} />
    <GoogleAnalytics />
    <slot name="head" />
    <script is:inline>
      const transitionKey = "geu-page-transition";

      try {
        const storedTransition = sessionStorage.getItem(transitionKey);
        const navigationEntry = performance.getEntriesByType("navigation")[0];
        const historyNavigation = navigationEntry?.type === "back_forward";
        let transitionMode = historyNavigation ? "quick" : null;

        if (storedTransition) {
          sessionStorage.removeItem(transitionKey);
          const transition = JSON.parse(storedTransition);
          const isRecent = Date.now() - transition.createdAt < 5000;
          if (
            isRecent &&
            (transition.mode === "hero" || transition.mode === "quick")
          ) {
            transitionMode = transition.mode;
          }
        }

        if (transitionMode) {
          document.documentElement.dataset.pageTransition = `${transitionMode}-enter`;
        }
      } catch {
        // Storage can be unavailable in strict privacy modes.
      }
    </script>
  </head>
  <body class:list={[{ "theme-minecraft": theme === "minecraft" }]}>
    <slot name="hero" />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { initPageTransitions } from "../scripts/page-transitions";

      initPageTransitions();
    </script>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  main {
    display: flex;
    flex-direction: column;
    flex: 1 0 auto;
  }
</style>
