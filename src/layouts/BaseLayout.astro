---
/**
 * Shared document shell for every page: head metadata (via SeoHead),
 * global styles, hero slot, main content, and footer.
 *
 * GoogleAnalytics renders nothing until the team opts in through siteConfig.
 */
import GoogleAnalytics from "../components/seo/GoogleAnalytics.astro";
import SeoHead from "../components/seo/SeoHead.astro";
import type { SeoProps } from "../components/seo/SeoHead.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import { localAssets } from "../data/local-assets";
import { siteConfig } from "../data/site";
import "../styles/global.css";

interface Props {
  seo: SeoProps;
  theme?: "default" | "minecraft";
}

const { seo, theme = "default" } = Astro.props;
const headerLogo =
  theme === "minecraft" ? localAssets.geuLogoPixel : localAssets.geLogoBig;
---

<!doctype html>
<html lang={seo.lang ?? siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="preload" as="image" href={headerLogo} />
    <SeoHead {...seo} />
    <GoogleAnalytics />
    <slot name="head" />
    <script is:inline>
      try {
        const key = "geu-page-transition";
        const stored = sessionStorage.getItem(key);
        const navigation = performance.getEntriesByType("navigation")[0];
        let transition = stored ? JSON.parse(stored) : null;
        if (stored) sessionStorage.removeItem(key);
        if (Date.now() - transition?.createdAt >= 5000) transition = null;

        const mode =
          navigation?.type === "back_forward" ? "quick" : transition?.mode;
        if (mode === "hero" || mode === "quick") {
          const root = document.documentElement;
          root.dataset.pageTransition = `${mode}-enter`;

          const ring = mode === "hero" ? transition?.ring : null;
          if (
            Number.isFinite(ring?.heroHeight) &&
            (ring.hero === "home" || ring.hero === "inner")
          ) {
            root.dataset.transitionSource = ring.hero;
            root.dataset.transitionHeight = ring.heroHeight;
          }

          const elapsed = Date.now() - ring?.startedAt;
          if (
            Number.isFinite(ring?.x) &&
            Number.isFinite(ring?.y) &&
            elapsed >= 0 &&
            elapsed < 320
          ) {
            root.dataset.transitionRing = "active";
            root.style.setProperty("--ring-x", `${ring.x}px`);
            root.style.setProperty("--ring-y", `${ring.y}px`);
            root.style.setProperty("--ring-delay", `${-elapsed}ms`);
          }
        }
      } catch {
        // Storage can be unavailable in strict privacy modes.
      }
    </script>
  </head>
  <body class:list={[{ "theme-minecraft": theme === "minecraft" }]}>
    <div class="transition-ring-clip" aria-hidden="true">
      <div class="transition-ring" data-transition-ring></div>
    </div>
    <slot name="hero" />
    <script is:inline>
      const root = document.documentElement;
      const panel = document.querySelector("[data-transition-panel]");
      if (panel) {
        const height = Number(root.dataset.transitionHeight);
        if (
          root.dataset.pageTransition === "hero-enter" &&
          Number.isFinite(height)
        ) {
          panel.style.minHeight = "0";
          panel.style.height = `${height}px`;
        }

        if (root.dataset.transitionRing === "active") {
          const bounds = panel.getBoundingClientRect();
          const values = {
            "--ring-left": `${bounds.left}px`,
            "--ring-top": `${bounds.top}px`,
            "--ring-width": `${bounds.width}px`,
            "--ring-height": `${bounds.height}px`,
            "--ring-radius": getComputedStyle(panel).borderRadius,
          };
          for (const [property, value] of Object.entries(values)) {
            root.style.setProperty(property, value);
          }
        }
      }
    </script>
    <main>
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { initPageTransitions } from "../scripts/page-transitions";

      initPageTransitions();
    </script>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  main {
    display: flex;
    flex-direction: column;
    flex: 1 0 auto;
  }
</style>
