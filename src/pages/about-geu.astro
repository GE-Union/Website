---
import TeamCarousel from "../components/about/TeamCarousel.astro";
import JoinCallout from "../components/content/JoinCallout.astro";
import SectionDivider from "../components/content/SectionDivider.astro";
import PageHero from "../components/layout/PageHero.astro";
import { getPageSeo } from "../data/seo-matrix";
import BaseLayout from "../layouts/BaseLayout.astro";

const teams = [
  {
    title: "Events 🎫",
    text: "From Exam Brush-Up sessions to Grill Parties, we host all sorts of events to save your exams, help unwind, and help you bond across years. All events are designed to help us meet new people, open doors of opportunity, and build a strong social community.",
  },
  {
    title: "Digital 🌐",
    text: "All the knowledge about GE – no fluff. We’ve bundled the hacks we wish we had into one place: honest takes on the four specialisations, past exams, revised notes, formula booklets, and a deadline calendar. Most importantly, it’s about sharing and supporting each other so no one has to study alone.",
  },
  {
    title: "Marketing 📈",
    text: "No good events without good marketing!\nOur creative minds of this team work hard to get the word out about any and all GE and GE Union related activities. Be that online with Instagram, LinkedIn and Facebook, or in person with flyers and the good 'ol word of mouth.",
  },
  {
    title: "Partnerships 💼",
    text: "From company visits to career tips, we connect you with opportunities worth grabbing. You’ll meet industry professionals, hear what companies actually look for, and get a feel for different fields. Along the way, you build a network that could kickstart your career, while picking up the tools to stand out.",
  },
];
---

<BaseLayout seo={getPageSeo("/about-geu")}>
  <PageHero
    slot="hero"
    title="about GE Union"
    subtitle="Who are we and why are we here?"
  />
  <section class="identity-section">
    <div class="identity-row">
      <div class="identity-summary">
        <p>GEU is a student-led community hub</p>
        <strong>by GE students<br />for GE students</strong>
      </div>
      <section class="identity-card icon-background">
        <h2>who we are</h2>
        <p>GEU is a student-led community hub</p>
        <strong>by GE students<br />for GE students</strong>
      </section>
      <section class="goal">
        <h2>Our Goal</h2><p>
          Our goal is to turn GE into one close, supportive community. We want
          to create connections across all three years, helping you meet people
          you wouldn’t normally meet, showing you the academic opportunities DTU
          offers, and keeping you updated on all that is relevant for a GE
          student. All in all, we want to better your social and academic life
          as a student in GE.
        </p>
      </section>
    </div>
  </section>
  <SectionDivider />
  <section class="teams-section">
    <h2>Our Teams</h2>
    <div class="team-cards">
      {
        teams.map((team) => (
          <article>
            <h3>{team.title}</h3>
            <p>{team.text}</p>
          </article>
        ))
      }
    </div>
    <TeamCarousel />
  </section>
  <SectionDivider />
  <section class="join-section">
    <JoinCallout heading="Want to Join?" />
  </section>
</BaseLayout>

<style>
  .identity-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: min(3vw, 60px);
    width: 94vw;
    margin: 70px auto 20px;
  }
  .identity-card {
    flex: 0 0 520px;
    width: 520px;
    min-height: 265px;
    padding: 18px 36px 24px;
    border-radius: var(--rad1);
    color: white;
    box-shadow:
      -1px -2px 3px #00000026 inset,
      1px 2px 3px #ffffff33 inset,
      0 5px 27px #0000002b;
    transform: rotate(-0.5deg);
  }
  .identity-card h2 {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 8px;
    font-family: Tanker, Rubik, sans-serif;
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .identity-card h2::before {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #f7f7f7;
    box-shadow:
      -0.75px -1.5px 1.5px #00000026,
      0.75px 1.5px 1.5px #ffffff40;
    content: "";
  }
  .identity-card p,
  .identity-summary p {
    font-weight: 700;
  }
  .identity-card strong,
  .identity-summary strong {
    display: block;
    font-family: Tanker, Rubik, sans-serif;
    line-height: 1.05;
    text-align: center;
    text-transform: uppercase;
  }
  .identity-card strong {
    margin-top: 4px;
    font-size: 3.6rem;
  }
  .identity-summary {
    display: none;
    text-align: center;
  }
  .identity-summary strong {
    font-size: 3.95rem;
  }
  .goal {
    max-width: 687px;
  }
  .teams-section {
    text-align: center;
  }
  .team-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    padding: 0 20px;
  }
  article {
    padding: 25px 18px;
    border-radius: 16px;
    background: #eee;
    white-space: pre-line;
  }
  article h3 {
    margin: 0 0 20px;
  }
  .join-section {
    max-width: 800px;
    margin: 0 auto 20px;
  }
  @media (max-width: 991px) {
    .identity-row {
      flex-direction: column;
      gap: min(3vw, 60px);
      margin-left: 3%;
      margin-right: 3%;
    }
    .identity-card {
      display: none;
    }
    .identity-summary {
      display: block;
    }
    .goal {
      margin: 0 10px;
      text-align: center;
    }
    .join-section {
      max-width: none;
      margin-left: 40px;
      margin-right: 40px;
    }
    .team-cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .team-cards {
      grid-template-columns: 1fr;
    }
    .identity-summary strong {
      font-size: 3.15rem;
    }
  }
  @media (max-width: 479px) {
    .identity-row {
      margin-top: 60px;
    }
    .identity-summary p {
      font-size: 16px;
    }
    .identity-summary strong {
      font-size: 2.8rem;
    }
    .join-section {
      margin-left: 20px;
      margin-right: 20px;
    }
  }
</style>
