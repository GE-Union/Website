---
import HomeCarousel from "../components/home/HomeCarousel.astro";
import MiniCalendar from "../components/home/MiniCalendar.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import ArrowIcon from "../components/ui/ArrowIcon.astro";
import CtaLink from "../components/ui/CtaLink.astro";
import { applicationUrl, homeReels } from "../data/home";
import { localAssets } from "../data/local-assets";
import { getPageSeo } from "../data/seo-matrix";
import BaseLayout from "../layouts/BaseLayout.astro";

const socialBlocks = [
  {
    title: "Instagram",
    text: "Follow us on Instagram for job postings, epic events, memes, and all the GE vibes you need!",
    label: "See on Instagram",
    href: "https://www.instagram.com/ge.union/",
  },
  {
    title: "LinkedIn",
    text: "A community connecting students and graduates! This space helps with career support, job searches, industry insights, and student-relevant job postings from alumni.",
    label: "LinkedIn Network",
    href: "https://www.linkedin.com/company/ge-union",
  },
  {
    title: "Reddit",
    text: "We’re also active on the DTU subreddit! Look out for the GE flair, where we answer questions from future GE students about housing, finances, and student life at DTU.",
    label: "See on Reddit",
    href: "https://www.reddit.com/r/DTU/",
  },
  {
    title: "Facebook",
    text: "Follow us on Facebook for job postings, events, memes, and all the GE vibes you need!",
    label: "See on Facebook",
    href: "https://www.facebook.com/people/GE-Union/61573069635006/?_rdr",
  },
] as const;

const reelColumns = [
  { position: "lower", reels: homeReels.slice(0, 1) },
  { position: "level", reels: homeReels.slice(1, 3) },
  { position: "raised", reels: homeReels.slice(3, 5) },
  { position: "level", reels: homeReels.slice(5, 6) },
] as const;
---

<BaseLayout seo={getPageSeo("/")}>
  <div slot="hero" class="home-stage">
    <header class="home-hero icon-background home-top">
      <SiteHeader />
      <div class="hero-copy">
        <h1>GE Union</h1><p>
          Your <strong>community hub</strong> at General Engineering!
        </p>
      </div>
    </header>
    <section class="feature-grid" aria-label="Student resources">
      <a class="feature calendar-card" href="/calendar">
        <h2>
          Calendar <span class="feature-arrow"><ArrowIcon /></span>
        </h2>
        <div class="calendar-body">
          <p>
            See all upcoming events, periods, and deadlines all in one place.<br
            /><br /><span>Everything relevant for GE Students.</span>
          </p><MiniCalendar /><img
            class="feature-icon calendar-icon"
            src={localAssets.calendar}
            alt=""
            width="650"
            height="570"
          />
        </div>
      </a>
      <a class="feature course-card" href="/course-bank"
        ><h2>
          Course Bank <span class="feature-arrow"><ArrowIcon /></span>
        </h2><p>See notes made by older students for your course!</p><img
          class="feature-icon"
          src={localAssets.vault}
          alt=""
          width="650"
          height="570"
        /></a
      >
      <a class="feature dashboard-card" href="/introduction"
        ><h2>
          Dashboard <span class="feature-arrow"><ArrowIcon /></span>
        </h2><p>
          All the relevant tools you will needs as a student studying General
          Engineering
        </p><img
          class="feature-icon"
          src={localAssets.dashboard}
          alt=""
          width="650"
          height="570"
        /></a
      >
    </section>
  </div>
  <section class="centered who-we-are">
    <img src={localAssets.geLogoSmall} alt="" width="498" height="618" /><h2>
      Who We Are
    </h2>
    <p>
      GE Union is the student organization for General Engineering at DTU.<br
      />We bring students together through social events, academic support, and
      career opportunities.
    </p>
    <CtaLink href="/about-geu" arrow>Meet GE Union</CtaLink>
  </section>
  <HomeCarousel />
  <section class="centered join">
    <h2>Want to join?</h2>
    <p>
      GEU is always looking for new people to join our team <span
        >(especially first years)</span
      >, so if you like what we do and want to help, or maybe want to use this
      as a safe space to gain experience, don't hesitate to send in an
      application! Whether you are interested in IT, event planning, marketing,
      social media, or contact with industry, we have a team that you will fit
      right into <span>(all while making sure to have lots of fun)</span>. So
      what are you waiting for??
    </p>
    <CtaLink href={applicationUrl} arrow>Submit your application</CtaLink>
  </section>
  <section class="social-panel">
    <section class="reels">
      {
        reelColumns.map((column) => (
          <div class:list={["reel-column", column.position]}>
            {column.reels.map((reel) => (
              <img
                src={reel.src}
                alt={reel.alt}
                width="540"
                height="960"
                loading="lazy"
              />
            ))}
          </div>
        ))
      }
    </section>
    <div class="social-content">
      {
        socialBlocks.map((block) => (
          <article class="social-block">
            <>
              <div>
                <>
                  <h2>{block.title}</h2>
                  <p>{block.text}</p>
                </>
              </div>
              <CtaLink href={block.href} arrow newTab>
                {block.label}
              </CtaLink>
            </>
          </article>
        ))
      }
      <article class="social-block contact">
        <div>
          <h2>Contact us</h2><p class="desktop-contact">
            You can reach us with any questions at <a
              class="email-link"
              href="mailto:geunion.dtu@gmail.com"
              ><span class="letter-mask" aria-hidden="true">
                <img
                  src={localAssets.envelope}
                  alt=""
                  width="512"
                  height="512"
                />
              </span><strong>geunion.dtu@gmail.com</strong></a
            >
          </p><p class="mobile-contact">
            Send us an email with any questions or suggestions you have, or drop
            us a message on Instagram.
          </p>
        </div><span class="mobile-email-cta"
          ><CtaLink href="mailto:geunion.dtu@gmail.com" arrow
            >Send Email</CtaLink
          ></span
        >
      </article>
    </div>
  </section>
</BaseLayout>

<script>
  import { initMiniCalendar } from "../scripts/mini-calendar";
  document
    .querySelectorAll<HTMLElement>("[data-mini-calendar]")
    .forEach((calendar) => initMiniCalendar(calendar));
</script>

<style>
  .home-stage {
    --hero-height: 57vh;
    --feature-height: clamp(440px, 62vh, 550px);
    --stage-height: clamp(650px, calc(100vh - 2 * var(--gap1)), 950px);
    position: relative;
    height: var(--stage-height);
    margin: var(--gap1) var(--gap1) 84px;
  }
  .home-hero {
    height: var(--hero-height);
    min-height: 300px;
    max-height: 686px;
    border-radius: var(--rad1);
  }
  .hero-copy {
    position: absolute;
    z-index: 1;
    top: 70px;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: calc(
      var(--stage-height) + var(--gap2) - var(--feature-height) - 70px
    );
    padding-inline: 32px;
    color: #fff;
    text-align: center;
  }
  .hero-copy h1 {
    font-size: clamp(5.25rem, 16vh, 7.5rem);
    margin-block: 0 -0.1em;
  }
  .hero-copy p {
    margin-inline: 35px;
    font-size: 1.3rem;
  }
  .feature-grid {
    position: absolute;
    z-index: 2;
    bottom: calc(-1 * var(--gap2));
    left: 50%;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: var(--gap2);
    width: min(84%, 1120px);
    height: var(--feature-height);
    margin: 0;
    padding: var(--gap2);
    border-radius: 16px;
    background: #fff;
    translate: -50% 0;
  }
  .feature {
    position: relative;
    overflow: hidden;
    padding: 20px;
    border-radius: var(--rad2);
    background: var(--back-grey-1);
    color: var(--front-1);
    text-decoration: none;
  }
  .feature h2 {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0;
    margin: 0;
    font-family: Tanker, Rubik, sans-serif;
    font-size: 2.6rem;
    font-weight: 500;
    text-transform: uppercase;
  }
  .feature-arrow {
    display: inline-grid;
    width: 0;
    height: 30px;
    overflow: hidden;
    place-items: center;
    opacity: 0.72;
    transition:
      width 0.4s ease,
      padding-left 0.4s ease;
  }
  .feature-arrow :global(.arrow-icon) {
    width: 30px;
    height: 30px;
  }
  .feature:hover .feature-arrow,
  .feature:focus-visible .feature-arrow {
    width: 38px;
    padding-left: 3px;
  }
  .feature p {
    position: relative;
    z-index: 2;
    align-self: center;
    color: var(--front-2);
    text-align: center;
    line-height: 1.3;
  }
  .feature-icon {
    position: absolute;
    right: -39px;
    bottom: 0;
    width: 260px;
    height: auto;
    opacity: 0.07;
    filter: blur(2px);
    pointer-events: none;
    user-select: none;
  }
  .calendar-icon {
    display: none;
  }
  .calendar-card {
    grid-row: 1 / 3;
  }
  .calendar-body {
    display: grid;
    grid-template-columns: minmax(145px, 30%) minmax(360px, 1fr);
    align-items: center;
    height: calc(100% - 52px);
  }
  .calendar-body p {
    width: 100%;
    max-width: 180px;
    padding-right: 10px;
    text-align: left;
  }
  .calendar-body span {
    color: var(--front-2);
  }
  .calendar-body :global(.mini-calendar) {
    width: calc(100% + 20px);
    min-width: 360px;
    margin: 20px 0 0 20px;
    background: rgb(255 255 255 / 0.17);
    box-shadow: 0 0 60px rgb(0 0 0 / 0.15);
  }
  .course-card,
  .dashboard-card {
    display: grid;
    grid-template-rows: auto 1fr;
  }
  .centered {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(900px, calc(100% - 40px));
    margin-inline: auto;
    text-align: center;
  }
  .centered h2 {
    margin-bottom: 22px;
  }
  .centered p {
    margin-bottom: 24px;
  }
  .who-we-are {
    margin-bottom: 20px;
  }
  .who-we-are > img {
    width: 22px;
    height: 28px;
    margin-bottom: 55px;
    opacity: 0.4;
  }
  .join {
    margin-bottom: 150px;
  }
  .join span {
    color: var(--front-muted-accessible);
  }
  .social-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 880px;
    margin: var(--gap1);
    padding: 60px 80px 40px 70px;
    overflow: hidden;
    border-radius: var(--rad1);
    background: var(--back-grey-1);
  }
  .reels {
    --reel-height: 250px;
    --reel-width: 150px;
    --reel-gap: 8px;
    position: absolute;
    z-index: 0;
    top: -65px;
    right: calc(22% - 500px);
    display: flex;
    gap: var(--reel-gap);
    width: calc(4 * var(--reel-width) + 3 * var(--reel-gap));
    height: 900px;
    rotate: 36deg;
    transform-origin: top center;
    pointer-events: none;
  }
  .reel-column {
    display: flex;
    flex: 0 0 var(--reel-width);
    flex-direction: column;
    gap: var(--reel-gap);
    width: var(--reel-width);
  }
  .reel-column.lower {
    margin-top: calc((var(--reel-height) + var(--reel-gap)) / 2);
  }
  .reel-column.level {
    margin-top: 0;
  }
  .reel-column.raised {
    margin-top: calc(-1 * (var(--reel-height) + var(--reel-gap)));
  }
  .reels img {
    flex: 0 0 var(--reel-height);
    width: var(--reel-width);
    height: var(--reel-height);
    border-radius: 18px;
    object-fit: cover;
    opacity: 0.85;
    filter: sepia(25%);
    user-select: none;
  }
  .social-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 60px;
    width: 100%;
    max-width: 1000px;
    margin: auto;
  }
  .social-block {
    display: grid;
    grid-template-columns: minmax(300px, 1fr) auto;
    align-items: center;
    gap: 100px;
  }
  .social-block h2 {
    margin-bottom: 16px;
  }
  .social-block p {
    width: 100%;
    max-width: 900px;
  }
  .social-block :global(.cta-link) {
    position: relative;
    z-index: 2;
    min-width: 215px;
    outline: 8px solid var(--back-grey-1);
    outline-offset: 0;
  }
  .social-block a:not(.cta-link) {
    color: inherit;
    text-decoration: none;
  }
  .mobile-contact,
  .mobile-email-cta {
    display: none;
  }
  .email-link {
    position: relative;
    display: inline-block;
  }
  .email-link strong {
    position: relative;
    z-index: 3;
  }
  .letter-mask {
    position: absolute;
    z-index: 1;
    top: -100px;
    left: 50%;
    width: 240px;
    height: 120px;
    overflow: hidden;
    translate: -50% 0;
    pointer-events: none;
  }
  .letter-mask::after {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    left: 0;
    height: 8px;
    background: linear-gradient(0deg, var(--back-grey-1), transparent);
    content: "";
  }
  .letter-mask img {
    width: 70%;
    height: auto;
    margin: 58px auto 0;
    opacity: 0.08;
    transition:
      translate 0.4s ease,
      rotate 0.4s ease,
      scale 0.4s ease,
      opacity 0.4s ease;
  }
  .email-link:hover .letter-mask img,
  .email-link:focus-visible .letter-mask img {
    translate: 0 -52px;
    rotate: 6deg;
    scale: 1.2;
    opacity: 0.15;
  }

  @media (max-width: 991px) {
    .home-stage {
      --hero-height: 44vh;
      --feature-height: clamp(410px, 48vh, 480px);
      --stage-height: clamp(340px, calc(80vh - 2 * var(--gap1)), 770px);
      margin-bottom: 78px;
    }
    .home-hero {
      min-height: 340px;
      max-height: none;
    }
    .hero-copy h1 {
      font-size: 4.84rem;
    }
    .feature h2 {
      font-size: 2.25rem;
    }
    .calendar-body {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .calendar-body :global(.mini-calendar) {
      display: none;
    }
    .calendar-body p {
      width: 95%;
      max-width: 251px;
      padding: 0;
      text-align: center;
    }
    .calendar-icon {
      display: block;
      right: 64px;
      bottom: 57px;
    }
    .social-panel {
      padding-right: 70px;
      padding-left: 55px;
    }
    .reels {
      right: -409px;
    }
    .social-content {
      gap: 50px;
    }
    .social-block {
      gap: 50px;
    }
  }

  @media (max-width: 767px) {
    .home-stage {
      --hero-height: 500px;
      --feature-height: 560px;
      --stage-height: 800px;
    }
    .feature-grid {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(3, minmax(0, 1fr));
      width: 84%;
    }
    .calendar-card {
      grid-row: auto;
    }
    .calendar-body {
      height: auto;
    }
    .calendar-body p span {
      display: none;
    }
    .feature-icon,
    .calendar-icon {
      right: -39px;
      bottom: 0;
    }
    .reels img {
      opacity: 0.2;
    }
    .centered {
      width: calc(100% - 55px);
    }
    .join {
      margin-bottom: 105px;
    }
    .social-panel {
      padding: 60px 34px 40px;
    }
    .social-block {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 20px;
    }
    .social-block h2 {
      text-align: left;
    }
    .social-block :global(.cta-link) {
      min-width: auto;
    }
    .desktop-contact {
      display: none;
    }
    .mobile-contact,
    .mobile-email-cta {
      display: block;
    }
  }

  @media (max-width: 479px) {
    .home-stage {
      --hero-height: 450px;
      --feature-height: 485px;
      --stage-height: 710px;
      margin: var(--gap1) var(--gap1) 0;
    }
    .home-hero {
      min-height: 0;
    }
    .hero-copy {
      top: 60px;
      gap: 4px;
      height: calc(
        var(--stage-height) + var(--gap2) - var(--feature-height) - 60px
      );
      padding: 0 20px;
    }
    .hero-copy h1 {
      font-size: 3.05rem;
      margin: 0;
    }
    .hero-copy p {
      margin: 0;
      font-size: 1.1rem;
    }
    .feature-grid {
      grid-template-rows: 180px 130px 147px;
      width: 90%;
      padding: 7px;
      border-radius: 13px;
    }
    .feature {
      padding: 10px;
    }
    .feature h2 {
      font-size: 2rem;
    }
    .feature-arrow {
      width: 30px;
      height: 25px;
      padding-left: 3px;
      opacity: 0.72;
    }
    .feature-arrow :global(.arrow-icon) {
      width: 25px;
      height: 25px;
    }
    .feature p,
    .calendar-body p {
      width: 90%;
      max-width: 400px;
      margin: 0 auto;
      font-size: 0.78rem;
      line-height: 1.25;
    }
    .calendar-body p {
      padding-top: 18px;
    }
    .feature-icon,
    .calendar-icon {
      right: -101px;
      width: 260px;
    }
    .who-we-are > img {
      margin-top: 60px;
      margin-bottom: 60px;
    }
    .who-we-are {
      padding-top: 25px;
      padding-bottom: 20px;
      margin-bottom: 100px;
    }
    .who-we-are p,
    .join p {
      font-size: 0.88rem;
    }
    .social-panel {
      min-height: 0;
      padding: 30px 15px;
    }
    .social-content {
      gap: 60px;
    }
    .reels {
      opacity: 0.15;
    }
    .social-block {
      gap: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-arrow,
    .letter-mask img {
      transition: none;
    }
  }
</style>
