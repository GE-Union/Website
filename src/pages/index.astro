---
import HomeCarousel from "../components/home/HomeCarousel.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeIntroduction from "../components/home/HomeIntroduction.astro";
import HomeJoin from "../components/home/HomeJoin.astro";
import HomeSocialPanel from "../components/home/HomeSocialPanel.astro";
import SectionDivider from "../components/content/SectionDivider.astro";
import { getPageSeo } from "../data/seo-matrix";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home-entry.css";
---

<BaseLayout seo={getPageSeo("/")}>
  <HomeHero slot="hero" />
  <SectionDivider />
  <HomeIntroduction />
  <HomeCarousel />
  <HomeJoin />
  <HomeSocialPanel />
</BaseLayout>

<style>
  .party-heading {
    width: 100%;
    max-width: 1000px;
    margin: 40px auto 24px;
    padding-inline: 20px;
    align-self: center;
    font-size: clamp(36px, 5vw, 64px);
    text-align: center;
  }

  .ticketbutler-iframe {
    /* Ticketbutler removes its internal card shadow at this iframe width. */
    width: 100%;
    max-width: 1000px;
    margin-inline: auto;
  }
</style>
