---
import CtaLink from "../ui/CtaLink.astro";
import { contactEmail, homeReels, homeSocialBlocks } from "../../data/home";
import { localAssets } from "../../data/local-assets";

const reelColumns = [
  { position: "lower", reels: homeReels.slice(0, 1) },
  { position: "level", reels: homeReels.slice(1, 3) },
  { position: "raised", reels: homeReels.slice(3, 5) },
  { position: "level", reels: homeReels.slice(5, 6) },
] as const;

const emailHref = `mailto:${contactEmail}`;
---

<section class="social-panel">
  <div class="reels" data-reels aria-hidden="true">
    {
      reelColumns.map((column) => (
        <div class:list={["reel-column", column.position]}>
          {column.reels.map((src) => (
            <img src={src} alt="" width="540" height="960" loading="lazy" />
          ))}
        </div>
      ))
    }
  </div>

  <div class="social-content">
    {
      homeSocialBlocks.map((block) => (
        <article class="social-block">
          <div>
            <h2>{block.title}</h2>
            <p>{block.text}</p>
          </div>
          <CtaLink href={block.href} arrow newTab>
            {block.label}
          </CtaLink>
        </article>
      ))
    }

    <article class="social-block contact">
      <div>
        <h2>Contact us</h2>
        <p class="desktop-contact">
          You can reach us with any questions at <a
            class="email-link"
            href={emailHref}
          >
            <span class="letter-mask" aria-hidden="true">
              <img src={localAssets.envelope} alt="" width="512" height="512" />
            </span>
            <strong>{contactEmail}</strong>
          </a>
        </p>
        <p class="mobile-contact">
          Send us an email with any questions or suggestions you have, or drop
          us a message on Instagram.
        </p>
      </div>
      <span class="mobile-email-cta">
        <CtaLink href={emailHref} arrow>Send Email</CtaLink>
      </span>
    </article>
  </div>
</section>

<script>
  import { initReelEntrances } from "../../scripts/reel-entrance";

  initReelEntrances();
</script>

<style>
  .social-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 880px;
    margin: var(--gap1);
    padding: 60px 80px 40px 70px;
    overflow: hidden;
    border-radius: var(--rad1);
    background: var(--back-grey-1);
  }

  .reels {
    --reel-height: 250px;
    --reel-width: 150px;
    --reel-gap: 8px;
    position: absolute;
    z-index: 0;
    top: -65px;
    right: calc(22% - 600px);
    display: flex;
    gap: var(--reel-gap);
    width: calc(4 * var(--reel-width) + 3 * var(--reel-gap));
    height: 900px;
    rotate: 36deg;
    transform-origin: top center;
    pointer-events: none;
  }

  .reel-column {
    display: flex;
    flex: 0 0 var(--reel-width);
    flex-direction: column;
    gap: var(--reel-gap);
    width: var(--reel-width);
  }

  .reel-column.lower {
    margin-top: calc((var(--reel-height) + var(--reel-gap)) / 2);
  }

  .reel-column.level {
    margin-top: 0;
  }

  .reel-column.raised {
    margin-top: calc(-1 * (var(--reel-height) + var(--reel-gap)) / 2);
  }

  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .reel-column {
      translate: 0 -100vh;
    }

    .reels.is-visible .reel-column {
      animation: reel-column-in 700ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .reels.is-visible .reel-column:nth-child(2) {
      animation-delay: 100ms;
    }

    .reels.is-visible .reel-column:nth-child(3) {
      animation-delay: 200ms;
    }

    .reels.is-visible .reel-column:nth-child(4) {
      animation-delay: 300ms;
    }
  }

  @keyframes reel-column-in {
    to {
      translate: 0 0;
    }
  }

  .reels img {
    flex: 0 0 var(--reel-height);
    width: var(--reel-width);
    height: var(--reel-height);
    border-radius: 18px;
    object-fit: cover;
    opacity: 0.85;
    filter: sepia(25%);
    user-select: none;
  }

  .social-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 60px;
    width: 100%;
    max-width: 1000px;
    margin: auto;
  }

  .social-block {
    display: grid;
    grid-template-columns: minmax(300px, 1fr) auto;
    align-items: center;
    gap: 100px;
  }

  .social-block h2 {
    margin-bottom: 16px;
  }

  .social-block p {
    width: 100%;
    max-width: 900px;
  }

  .social-block :global(.cta-link) {
    position: relative;
    z-index: 2;
    min-width: 215px;
    outline: 8px solid var(--back-grey-1);
    outline-offset: 0;
  }

  .social-block a:not(.cta-link) {
    color: inherit;
    text-decoration: none;
  }

  .mobile-contact,
  .mobile-email-cta {
    display: none;
  }

  .email-link {
    position: relative;
    display: inline-block;
  }

  .email-link strong {
    position: relative;
    z-index: 3;
  }

  .letter-mask {
    position: absolute;
    z-index: 1;
    top: -100px;
    left: 50%;
    width: 240px;
    height: 120px;
    overflow: hidden;
    translate: -50% 0;
    pointer-events: none;
  }

  .letter-mask::after {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    left: 0;
    height: 8px;
    background: linear-gradient(0deg, var(--back-grey-1), transparent);
    content: "";
  }

  .letter-mask img {
    width: 70%;
    height: auto;
    margin: 58px auto 0;
    opacity: 0.08;
    transition:
      translate 0.4s ease,
      rotate 0.4s ease,
      scale 0.4s ease,
      opacity 0.4s ease;
  }

  .email-link:hover .letter-mask img,
  .email-link:focus-visible .letter-mask img {
    translate: 0 -52px;
    rotate: 6deg;
    scale: 1.2;
    opacity: 0.15;
  }

  @media (max-width: 991px) {
    .social-panel {
      padding-right: 70px;
      padding-left: 55px;
    }

    .reels {
      right: -409px;
    }

    .social-content {
      gap: 50px;
    }

    .social-block {
      gap: 50px;
    }
  }

  @media (max-width: 767px) {
    .reels img {
      opacity: 0.2;
    }

    .social-panel {
      padding: 60px 34px 40px;
    }

    .social-block {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 20px;
    }

    .social-block h2 {
      text-align: left;
    }

    .social-block :global(.cta-link) {
      min-width: auto;
    }

    .desktop-contact {
      display: none;
    }

    .mobile-contact,
    .mobile-email-cta {
      display: block;
    }
  }

  @media (max-width: 479px) {
    .social-panel {
      min-height: 0;
      padding: 30px 15px;
    }

    .social-content {
      gap: 60px;
    }

    .reels {
      opacity: 0.15;
    }

    .social-block {
      gap: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .letter-mask img {
      transition: none;
    }
  }
</style>
