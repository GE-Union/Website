---
import Carousel from "../ui/Carousel.astro";
import { homeCarousel } from "../../data/home";
---

<Carousel
  items={homeCarousel.map((item) => ({
    src: item.src,
    alt: item.caption,
    caption: item.caption,
  }))}
  label="GE Union highlights"
  previousLabel="Previous image"
  nextLabel="Next image"
/>
