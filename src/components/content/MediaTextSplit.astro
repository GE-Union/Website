---
interface Props {
  reverse?: boolean;
  variant?: "default" | "dtu" | "pf" | "ida";
  class?: string;
}

const { reverse = false, variant = "default", class: className } = Astro.props;
---

<section
  class:list={[
    "media-text-split",
    `variant-${variant}`,
    className,
    { reverse },
  ]}
>
  <div class="media"><slot name="media" /></div>
  <div class="copy"><slot /></div>
</section>

<style>
  .media-text-split {
    display: grid;
    grid-template-columns: minmax(160px, 0.7fr) minmax(0, 1.7fr);
    align-items: center;
    gap: 48px;
  }
  .reverse {
    grid-template-columns: minmax(0, 1.7fr) minmax(160px, 0.7fr);
  }
  .reverse .media {
    order: 2;
  }
  .media :global(img) {
    display: block;
    max-width: 100%;
    max-height: 260px;
    margin: auto;
    object-fit: contain;
  }
  .variant-dtu .media :global(img) {
    width: 145px;
  }
  .variant-pf .media :global(img) {
    width: 180px;
  }
  .variant-ida .media :global(img) {
    width: 190px;
  }
  @media (min-width: 601px) and (max-width: 991px) {
    .variant-ida .media {
      align-self: start;
      transform: translate(-30px, -42px);
    }
    .variant-ida .media :global(img) {
      width: 165px;
    }
  }
  @media (max-width: 600px) {
    .media-text-split,
    .reverse {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .reverse .media {
      order: 0;
    }
    .media :global(img) {
      max-height: 180px;
    }
    .variant-dtu {
      gap: 24px;
    }
    .variant-dtu .media {
      width: 100%;
      height: 150px;
      overflow: hidden;
    }
    .variant-dtu .media :global(img) {
      width: 227px;
      max-width: none;
      max-height: none;
      transform: translateY(-154px);
    }
    .variant-pf {
      position: relative;
      display: block;
    }
    .variant-pf .media {
      position: absolute;
      z-index: 0;
      top: -28px;
      right: -22px;
      width: 190px;
      opacity: 0.2;
      pointer-events: none;
    }
    .variant-pf .copy {
      position: relative;
      z-index: 1;
    }
    .variant-ida .media {
      display: none;
    }
  }
</style>
