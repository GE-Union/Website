---
/**
 * Reusable call-to-action link treatment, converted from the legacy
 * "Learn more" button: red pill, white text, gentle hover scale, and an
 * optional arrow glyph. It is an anchor because CTAs navigate.
 */
import ArrowIcon from "./ArrowIcon.astro";

interface Props {
  href: string;
  /** Show the trailing arrow glyph (legacy "Learn more" style). */
  arrow?: boolean;
  /** Set for external links that should open in a new tab. */
  newTab?: boolean;
  /** More descriptive accessible name when the visible copy is intentionally terse. */
  label?: string;
}

const { href, arrow = false, newTab = false, label } = Astro.props;
---

<a
  class="cta-link"
  href={href}
  target={newTab ? "_blank" : undefined}
  rel={newTab ? "noopener noreferrer" : undefined}
  aria-label={label}
>
  <slot />
  {arrow && <ArrowIcon />}
</a>

<style>
  .cta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: fit-content;
    padding: 10px 20px;
    background-color: var(--action-red);
    border-radius: 12px;
    color: #fff;
    font-size: 20px;
    font-weight: 700;
    text-decoration: none;
    transition: 0.2s ease;
  }

  .cta-link:hover {
    scale: 1.03;
    box-shadow: 0 5px 16px rgb(242 68 74 / 0.2);
  }

  .cta-link:active {
    scale: 0.99;
  }

  @media (max-width: 767px) {
    .cta-link {
      font-size: 19px;
    }
  }
</style>
