---
interface CarouselItem {
  src: string;
  alt: string;
  caption: string;
}

interface Props {
  items: CarouselItem[];
  label: string;
  previousLabel: string;
  nextLabel: string;
}

const { items, label, previousLabel, nextLabel } = Astro.props;
---

<section
  class="carousel"
  aria-label={label}
  aria-roledescription="carousel"
  data-carousel
  tabindex="0"
>
  <div class="viewport" data-carousel-viewport>
    <div class="track" data-carousel-track>
      {
        items.map((item, index) => (
          <figure
            class="slide"
            data-carousel-slide
            data-active={index === 0 ? "true" : undefined}
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${items.length}`}
            aria-hidden={index === 0 ? undefined : "true"}
          >
            <img
              src={item.src}
              alt={item.alt}
              width="900"
              height="600"
              loading="lazy"
              draggable="false"
            />
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>

  <button
    class="control previous"
    type="button"
    aria-label={previousLabel}
    data-carousel-previous
  >
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <path d="m14.5 6-6 6 6 6"></path>
    </svg>
  </button>
  <button
    class="control next"
    type="button"
    aria-label={nextLabel}
    data-carousel-next
  >
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <path d="m9.5 6 6 6-6 6"></path>
    </svg>
  </button>

  <p class="visually-hidden" aria-live="polite" data-carousel-status>
    Image 1 of {items.length}
  </p>
</section>

<script>
  import { initCarousels } from "../../scripts/carousel";

  initCarousels();
</script>

<style>
  .carousel {
    --slide-width: 450px;
    --slide-height: 300px;
    --slide-gap: var(--gap1, 14px);

    position: relative;
    width: 100%;
    margin: 40px 0 84px;
    overflow: hidden;
    outline: none;
  }

  .viewport {
    height: calc(var(--slide-height) + 43px);
    overflow: hidden;
    padding-top: 8px;
    touch-action: pan-y pinch-zoom;
    cursor: grab;
  }

  .carousel[data-dragging="true"] .viewport {
    cursor: grabbing;
  }

  .track {
    position: relative;
    left: calc(50% - var(--slide-width) / 2);
    display: flex;
    width: max-content;
    gap: var(--slide-gap);
    will-change: transform;
    transition: transform 480ms cubic-bezier(0.22, 0.72, 0.2, 1);
  }

  .carousel[data-ready="true"] .track {
    left: 0;
  }

  .slide {
    flex: 0 0 var(--slide-width);
    width: var(--slide-width);
    margin: 0;
    text-align: center;
    opacity: 0.78;
    transform: translateY(0);
    transition:
      opacity 300ms ease,
      transform 420ms cubic-bezier(0.22, 0.72, 0.2, 1);
  }

  .slide[data-active="true"] {
    opacity: 1;
    transform: translateY(-5px);
  }

  .slide img {
    display: block;
    width: var(--slide-width);
    height: var(--slide-height);
    object-fit: cover;
    border-radius: var(--rad2, 8px);
    background: #eee;
    box-shadow: 0 3px 12px rgb(38 12 16 / 0.08);
    user-select: none;
    -webkit-user-drag: none;
  }

  figcaption {
    position: relative;
    z-index: -1;
    margin-top: -25px;
    padding-inline: 12px;
    font-size: 0.82rem;
    line-height: 1.3;
    opacity: 0;
    transform: translateY(-3px);
    transition:
      margin-top 420ms cubic-bezier(0.22, 0.72, 0.2, 1),
      opacity 180ms ease,
      transform 420ms cubic-bezier(0.22, 0.72, 0.2, 1);
  }

  .slide[data-active="true"] figcaption {
    z-index: 0;
    margin-top: 5px;
    opacity: 1;
    transform: translateY(0);
  }

  .control {
    position: absolute;
    top: calc(8px + var(--slide-height) / 2);
    z-index: 2;
    display: grid;
    width: 42px;
    height: 42px;
    padding: 0;
    place-items: center;
    border: 1px solid rgb(99 13 26 / 0.08);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    box-shadow: 0 3px 14px rgb(38 12 16 / 0.14);
    color: var(--front-1);
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      background-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
    backdrop-filter: blur(5px);
  }

  .control:hover {
    background: #fff;
    box-shadow: 0 5px 18px rgb(38 12 16 / 0.2);
    transform: translateY(-50%) scale(1.06);
  }

  .control:active {
    transform: translateY(-50%) scale(0.96);
  }

  .control:focus-visible,
  .carousel:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--front-1) 36%, transparent);
    outline-offset: 3px;
  }

  .control svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.2;
  }

  .previous {
    left: max(10px, calc(50% - var(--slide-width) / 2 - 56px));
  }

  .next {
    right: max(10px, calc(50% - var(--slide-width) / 2 - 56px));
  }

  @media (max-width: 767px) {
    .carousel {
      --slide-width: 270px;
      --slide-height: 180px;
      --slide-gap: 10px;

      margin: 30px 0 70px;
    }

    .control {
      width: 38px;
      height: 38px;
    }

    .previous {
      left: max(8px, calc(50% - var(--slide-width) / 2 - 48px));
    }

    .next {
      right: max(8px, calc(50% - var(--slide-width) / 2 - 48px));
    }
  }

  @media (max-width: 479px) {
    .carousel {
      --slide-width: 225px;
      --slide-height: 150px;
      --slide-gap: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track,
    .slide,
    figcaption,
    .control {
      transition-duration: 0.01ms;
    }
  }
</style>
