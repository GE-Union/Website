---
import { eventCalendarConfig } from "../../data/calendar";

const apiKey = import.meta.env.PUBLIC_GOOGLE_CALENDAR_API_KEY?.trim() ?? "";
---

<section
  class="event-calendar"
  aria-label="GE Union events"
  data-event-calendar
  data-api-key={apiKey}
  data-calendar-id={eventCalendarConfig.googleCalendarId}
  data-cutoff-hour={eventCalendarConfig.lateNightCutoffHour}
  data-locale={eventCalendarConfig.locale}
  data-calendar-state="loading"
>
  <p class="visually-hidden" aria-live="polite" data-calendar-live>
    Loading calendar events…
  </p>

  <div class="calendar-notice" data-calendar-notice hidden>
    <p data-calendar-notice-text>Loading calendar events…</p>
    <button type="button" data-calendar-retry hidden>Retry</button>
  </div>

  <div class="calendar-grid" data-calendar-grid aria-busy="true"></div>

  <noscript>
    <p class="calendar-noscript">
      JavaScript is required to load calendar events.
    </p>
  </noscript>

  <dialog
    class="event-dialog"
    data-event-dialog
    aria-labelledby="event-dialog-title"
    tabindex="-1"
  >
    <div class="event-dialog-card">
      <button type="button" class="visually-hidden" data-event-dialog-close>
        Close event details
      </button>

      <div class="event-dialog-content">
        <div class="event-dialog-row event-dialog-title-row">
          <span class="event-dialog-dot event-dialog-title-dot"></span>
          <h3 id="event-dialog-title" data-event-title>Event details</h3>
        </div>

        <div class="event-dialog-row">
          <span class="event-dialog-dot"></span>
          <p data-event-date></p>
        </div>

        <div class="event-dialog-row" data-event-time-row>
          <span class="event-dialog-dot"></span>
          <p data-event-time></p>
        </div>

        <div class="event-dialog-row" data-event-location-row>
          <span class="event-dialog-dot"></span>
          <p data-event-location></p>
        </div>

        <hr class="event-dialog-rule" data-event-description-rule />
        <div class="event-description" data-event-description></div>
      </div>

      <img
        class="event-dialog-logo"
        src="/assets/logos/ge-logo-big.svg"
        alt=""
        width="492"
        height="684"
      />
    </div>
  </dialog>
</section>

<script>
  import { initEventCalendars } from "../../scripts/event-calendar";

  initEventCalendars();
</script>

<style>
  .event-calendar {
    width: auto;
    min-width: 0;
    margin: 80px calc(3 * var(--gap1));
  }

  .calendar-notice,
  .calendar-noscript {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 44px;
    padding: 9px 14px;
    margin: 0 0 18px;
    border: 1px solid var(--back-grey-1);
    border-radius: var(--rad2);
    background: var(--back-grey-2);
    color: var(--front-2);
    font-size: 0.9rem;
    text-align: center;
  }

  .calendar-notice[hidden] {
    display: none;
  }

  .calendar-notice button {
    flex: 0 0 auto;
    padding: 5px 14px;
    border: 0;
    border-radius: 7px;
    background: var(--action-red);
    color: white;
    font-weight: 600;
    cursor: pointer;
  }

  .calendar-grid {
    min-width: 0;
  }

  .calendar-grid :global(.fc-daygrid-day-number) {
    color: inherit;
    text-decoration: none;
    user-select: none;
  }

  .calendar-grid :global(.fc-button-primary) {
    border-color: var(--back-red-1) !important;
    background: var(--back-red-1) !important;
    color: white !important;
    box-shadow: none !important;
  }

  .calendar-grid :global(.fc-button-primary:hover),
  .calendar-grid :global(.fc-button-primary:focus-visible) {
    border-color: var(--action-red) !important;
    background: var(--action-red) !important;
  }

  .calendar-grid :global(.fc-button-primary:disabled) {
    opacity: 0.65;
  }

  .calendar-grid :global(.fc-event) {
    border-color: var(--back-red-1) !important;
    background: var(--back-red-1) !important;
    color: white !important;
    cursor: pointer;
  }

  .calendar-grid :global(.fc-event:focus) {
    box-shadow: none;
  }

  .calendar-grid :global(.fc-event:focus::before),
  .calendar-grid :global(.fc-event:focus::after) {
    content: none;
  }

  .calendar-grid :global(.fc-event-title) {
    padding: 0 4px;
    overflow: hidden;
    font-weight: 400;
    text-overflow: ellipsis;
  }

  .calendar-grid :global(.fc-scrollgrid td) {
    border: 1px solid var(--back-grey-1);
  }

  .calendar-grid :global(.fc-scrollgrid),
  .calendar-grid :global(.fc-col-header-cell),
  .calendar-grid :global(.fc-scrollgrid th) {
    border: 0 !important;
  }

  .calendar-grid :global(.fc-day-today) {
    border-radius: 0 !important;
    background: rgb(237 104 115 / 0.17) !important;
    box-shadow: 0 0 80px rgb(237 104 115 / 0.1);
  }

  .calendar-grid :global(.fc-day-today .fc-daygrid-day-number) {
    font-weight: 600;
  }

  .calendar-grid :global(.fc-daygrid-day-frame) {
    min-height: 110px;
  }

  .calendar-grid :global(.fc-daygrid-day-top) {
    margin-bottom: -7px;
  }

  .calendar-grid :global(.fc-daygrid-day-events) {
    margin-bottom: 2px !important;
  }

  .event-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0 0 6vh;
    margin: 0;
    border: 0;
    background: transparent;
    color: var(--front-1);
    overflow: hidden;
  }

  .event-dialog[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .event-dialog::backdrop {
    background: #00000061;
    backdrop-filter: blur(10px);
    animation: event-dialog-backdrop-in 0.1s ease-out;
  }

  .event-dialog[data-closing="true"]::backdrop {
    animation: event-dialog-backdrop-out 0.1s ease-out forwards;
  }

  .event-dialog-card {
    position: relative;
    display: flex;
    justify-content: space-between;
    padding: var(--gap2);
    border-radius: var(--rad1);
    background: var(--background);
    box-shadow: 0 2px 61px #0003;
    overflow: clip;
    animation: event-dialog-card-in 0.15s ease;
  }

  .event-dialog[data-closing="true"] .event-dialog-card {
    animation: event-dialog-card-out 0.15s ease-in forwards;
  }

  .event-dialog-content {
    z-index: 1;
    flex: 1 1 auto;
    width: clamp(600px, 60vw, 900px);
    max-height: 70vh;
    margin: 25px 30px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .event-dialog-row {
    display: flex;
    height: min-content;
  }

  .event-dialog-title-row {
    margin-bottom: 4px;
  }

  .event-dialog h3 {
    margin: 0 0 0 0.5em;
    font-size: 1.4em;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .event-dialog-dot {
    flex: 0 0 auto;
    align-self: center;
    height: 0.5em;
    margin-left: 0.15em;
    border-radius: 10px;
    aspect-ratio: 1;
    background: var(--back-red-1);
  }

  .event-dialog-title-dot {
    height: 0.8em;
    margin-left: 0;
    border-radius: 5px;
  }

  .event-dialog-row p {
    margin-left: 0.8em;
    color: var(--front-3);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .event-dialog-row[hidden] {
    display: none;
  }

  .event-dialog-rule {
    width: 90%;
    margin-top: 20px;
    margin-bottom: 20px;
    border-top: 0;
    border-right: 0;
    border-bottom: 1px solid var(--front-3);
    border-left: 0;
    color: gray;
    opacity: 0.4;
  }

  .event-description {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .event-dialog-rule[hidden],
  .event-description[hidden] {
    display: none;
  }

  .event-dialog-logo {
    position: absolute;
    top: -92px;
    right: 12px;
    width: 340px;
    height: 450px;
    margin-left: auto;
    opacity: 0.03;
    filter: invert(100%);
    transform: rotate(-11deg);
    user-select: none;
    pointer-events: none;
  }

  @keyframes event-dialog-backdrop-in {
    from {
      opacity: 0;
    }
  }

  @keyframes event-dialog-backdrop-out {
    to {
      opacity: 0;
    }
  }

  @keyframes event-dialog-card-in {
    from {
      transform: scale(0.9);
    }
  }

  @keyframes event-dialog-card-out {
    to {
      filter: blur(12px);
      opacity: 0;
      transform: scale(0.9);
    }
  }

  @media (max-width: 767px) {
    .event-calendar {
      margin: 70px 0;
    }

    .calendar-notice,
    .calendar-noscript {
      margin-right: calc(2 * var(--gap1));
      margin-left: calc(2 * var(--gap1));
    }

    .calendar-grid :global(.fc-header-toolbar) {
      margin-right: calc(2 * var(--gap1));
      margin-left: calc(2 * var(--gap1));
    }

    .calendar-grid :global(.fc-view-harness) {
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scrollbar-width: thin;
      -webkit-overflow-scrolling: touch;
    }

    .calendar-grid :global(.fc-scrollgrid) {
      min-width: 650px;
      font-size: 0.7em;
    }

    .calendar-grid :global(.fc-daygrid-day-frame) {
      min-height: 75px;
    }

    .calendar-grid :global(.fc-button) {
      padding: 0 5px !important;
    }

    .calendar-grid :global(.fc-button .fc-icon) {
      font-size: 20px !important;
    }

    .calendar-grid :global(.fc-toolbar-title) {
      padding-left: 10px;
      font-size: 18px !important;
      text-align: center;
    }
  }

  @media (max-width: 991px) {
    .event-dialog-content {
      width: 80vw;
    }
  }

  @media (max-width: 767px) {
    .event-dialog-content {
      width: 78vw;
    }
  }

  @media (max-width: 479px) {
    .event-dialog-content {
      margin: 15px;
    }

    .event-dialog-logo {
      right: -101px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-dialog::backdrop,
    .event-dialog-card {
      animation: none;
    }
  }
</style>
