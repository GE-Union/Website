---
import ArrowIcon from "../ui/ArrowIcon.astro";
import { courseBankLinks, courseCategories } from "../../data/course-bank";

const splitEmphasis = (text: string, emphasis: string) => {
  const index = text.indexOf(emphasis);
  if (index < 0) return { before: "", emphasis: "", after: text };
  return {
    before: text.slice(0, index),
    emphasis,
    after: text.slice(index + emphasis.length),
  };
};
---

<section
  class="course-bank"
  aria-label="Course Bank catalog"
  data-course-bank
  data-course-bank-state="loading"
>
  <p class="visually-hidden" aria-live="polite" data-course-bank-status>
    Loading course notes…
  </p>

  <div
    class="tab-list"
    role="tablist"
    aria-label="Course categories"
    aria-orientation="horizontal"
    data-course-tabs
  >
    {
      courseCategories.map((category, index) => (
        <button
          type="button"
          id={`course-tab-${category.id}`}
          role="tab"
          aria-controls={`course-panel-${category.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
        >
          <span class="full-tab-label">{category.label}</span>
          <span class="short-tab-label">{category.shortLabel}</span>
        </button>
      ))
    }
  </div>

  <div class="load-notice" data-course-bank-notice hidden>
    <p data-course-bank-notice-text></p>
    <button type="button" data-course-bank-retry>Retry</button>
  </div>

  {
    courseCategories.map((category, categoryIndex) => {
      const intro = splitEmphasis(category.description, category.emphasis);
      return (
        <section
          class="tab-panel"
          id={`course-panel-${category.id}`}
          role="tabpanel"
          aria-labelledby={`course-tab-${category.id}`}
          tabindex="0"
          hidden={categoryIndex !== 0}
        >
          <p class="category-intro">
            {intro.before}
            {intro.emphasis && <strong>{intro.emphasis}</strong>}
            {intro.after}
          </p>

          <div class="course-list">
            {category.courses.map((course) => (
              <>
                {"separated" in course && course.separated && (
                  <hr class="course-separator" />
                )}
                <details class="course">
                  <summary>
                    <span class="course-title">
                      <span class="course-name">{course.name}</span>
                      <span class="course-code">{course.code}</span>
                    </span>
                    <svg aria-hidden="true" viewBox="0 0 16 16">
                      <path d="m4 6 4 4 4-4" />
                    </svg>
                  </summary>
                  <div class="course-reveal">
                    <div class="course-body">
                      <p>{course.description}</p>
                      <p class="notes-heading">Notes</p>
                      <div
                        class="file-list"
                        data-course-files
                        data-folder={course.folder}
                        aria-busy="true"
                      >
                        <p class="file-state">Loading…</p>
                      </div>
                    </div>
                  </div>
                </details>
              </>
            ))}
          </div>
        </section>
      );
    })
  }

  <div class="course-actions">
    <div class="action-card">
      <h2>See more on</h2>
      <a
        class="action-link studocu"
        href={courseBankLinks.studocu}
        target="_blank"
        rel="noopener noreferrer"
      >
        Studocu <ArrowIcon />
      </a>
    </div>
    <div class="action-card">
      <h2>Upload notes</h2>
      <a
        class="action-link upload"
        href={courseBankLinks.upload}
        target="_blank"
        rel="noopener noreferrer"
      >
        Here <ArrowIcon />
      </a>
    </div>
  </div>
</section>

<script>
  import { initCourseBanks } from "../../scripts/course-bank";

  initCourseBanks();
</script>

<style>
  .course-bank {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 50px var(--gap1) 0;
  }

  .tab-list {
    display: inline-flex;
    justify-content: center;
    gap: 5px;
    padding: 5px;
    margin-bottom: 40px;
    border-radius: var(--rad1);
    background: var(--back-grey-1);
    font-size: 0.875rem;
  }

  [role="tab"] {
    padding: 0.375rem 0.75rem;
    border: 0;
    border-radius: calc(var(--rad1) - 5px);
    background: transparent;
    color: inherit;
    font-weight: 500;
    line-height: 1.15;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      box-shadow 150ms ease;
  }

  [role="tab"]:hover {
    background: #0000000a;
  }

  [role="tab"][aria-selected="true"] {
    background: var(--background);
    color: #020817;
    box-shadow: 0 1px 2px #0000000d;
  }

  .short-tab-label {
    display: none;
  }

  .load-notice {
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(90%, 900px);
    padding: 10px 14px;
    margin: -25px 0 25px;
    border: 1px solid var(--back-grey-1);
    border-radius: var(--rad2);
    background: var(--back-grey-2);
    font-size: 0.875rem;
  }

  .load-notice[hidden] {
    display: none;
  }

  .load-notice p {
    flex: 1;
  }

  .load-notice button {
    padding: 5px 12px;
    border: 0;
    border-radius: 8px;
    background: var(--action-red);
    color: white;
    font-weight: 600;
    cursor: pointer;
  }

  .tab-panel {
    width: 80%;
    max-width: 900px;
  }

  .category-intro {
    padding: 5px 0 30px;
    text-align: center;
  }

  .course summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 10px;
    margin: 5px 0;
    border-radius: var(--rad2);
    outline: 1px solid var(--back-grey-1);
    background: var(--back-grey-2);
    color: var(--front-2);
    font-size: 20px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .course summary::-webkit-details-marker {
    display: none;
  }

  .course summary svg {
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .course[open] summary svg,
  .course[data-course-expanded="true"] summary svg {
    transform: rotate(180deg);
  }

  .course[data-course-expanded="false"] summary svg {
    transform: rotate(0);
  }

  .course-title {
    min-width: 0;
  }

  .course-name {
    white-space: normal;
  }

  .course-code {
    padding-left: 1em;
    color: var(--front-3);
    font-size: 17px;
    font-weight: 400;
  }

  .course-body {
    padding: 0 var(--gap1) 1rem;
    opacity: 0;
    font-size: 0.875rem;
    line-height: 1.25rem;
    transform: translateY(-6px);
    transition:
      opacity 180ms ease,
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .course[open] > .course-reveal > .course-body,
  .course[data-course-expanded="true"] > .course-reveal > .course-body {
    opacity: 1;
    transform: translateY(0);
  }

  .course[data-course-expanded="false"] > .course-reveal > .course-body {
    opacity: 0;
    transform: translateY(-6px);
  }

  .notes-heading {
    margin: 1em 0 0;
    font-size: 1em;
    font-weight: 600;
  }

  .file-list {
    display: flex;
    flex-wrap: wrap;
    max-width: 850px;
  }

  .file-state {
    margin: 0.65em 0;
    color: var(--front-3);
  }

  .course-bank :global(.course-file-row) {
    display: flex;
    flex: 1 0 300px;
    align-items: center;
    width: 50%;
    min-width: 300px;
    max-width: 500px;
    height: 40px;
    margin: 1em 0;
    transition: transform 100ms ease;
  }

  .course-bank :global(.course-file-row:hover) {
    transform: translateX(5px);
  }

  .course-bank :global(.course-file-link) {
    display: flex;
    align-items: center;
    width: 100%;
    color: inherit;
    line-height: 1.2;
    text-decoration: none;
  }

  .course-bank :global(.course-file-icon) {
    position: relative;
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    margin-right: 10px;
  }

  .course-bank :global(.course-file-icon img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .course-bank :global(.course-file-badge) {
    position: absolute;
    top: 14px;
    left: 1px;
    padding: 1px 2px;
    border-radius: 2px;
    color: white;
    font-size: 10px;
    font-weight: 500;
    line-height: normal;
    pointer-events: none;
  }

  .course-bank :global(.course-file-details) {
    display: flex;
    flex-direction: column;
    width: calc(100% - 58px);
  }

  .course-bank :global(.course-file-name),
  .course-bank :global(.course-file-author) {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .course-bank :global(.course-file-name) {
    color: var(--front-1);
    font-size: 1em;
    font-weight: 500;
  }

  .course-bank :global(.course-file-row:hover .course-file-name) {
    color: var(--action-red);
  }

  .course-bank :global(.course-file-author) {
    color: var(--front-3);
    font-size: 0.8em;
  }

  .course-separator {
    width: 40px;
    margin: 16px auto;
    border: 0;
    border-bottom: 1.5px solid var(--front-3);
    opacity: 0.5;
  }

  .course-actions {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: 20px;
    width: max-content;
    margin: 70px auto 90px;
  }

  .action-card {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: flex-end;
    width: 310px;
    padding: 3px;
    border: 4px solid var(--back-grey-1);
    border-radius: 18px;
  }

  .action-card h2 {
    flex: 1;
    margin: 0;
    padding-inline: 12px;
    font-size: 0.875rem;
    line-height: 1.2;
    text-align: right;
    white-space: nowrap;
  }

  .action-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 44px;
    padding: 10px 20px;
    border-radius: 12px;
    background: var(--action-red);
    color: white;
    font-weight: 500;
    text-decoration: none;
  }

  .action-link.studocu {
    width: 145px;
  }

  .action-link.upload {
    width: 125px;
  }

  @media (max-width: 767px) {
    .tab-panel {
      width: 100%;
    }

    .full-tab-label {
      display: none;
    }

    .short-tab-label {
      display: inline;
    }

    .action-card {
      width: 295px;
    }

    .course-actions {
      flex-wrap: wrap;
      width: min-content;
    }
  }

  @media (max-width: 479px) {
    .tab-list {
      flex-direction: column;
      align-items: stretch;
      width: min-content;
      gap: 0;
      font-size: 0.95rem;
    }

    .full-tab-label {
      display: inline;
    }

    .short-tab-label {
      display: none;
    }

    [role="tab"] {
      width: 100%;
      padding-block: 0.3rem;
    }

    .course-code {
      display: none;
    }

    .category-intro {
      font-size: 0.9rem;
    }

    .course summary {
      font-size: 18px;
    }

    .course-actions {
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [role="tab"],
    .course summary svg,
    .course-body,
    .course-bank :global(.course-file-row) {
      transition: none;
    }

    .course-bank :global(.course-file-row:hover) {
      transform: none;
    }
  }
</style>
