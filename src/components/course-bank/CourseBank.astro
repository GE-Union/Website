---
import "../../styles/course-bank.css";
---

<section class="course-bank" data-course-bank data-course-bank-state="loading">
  <p class="visually-hidden" aria-live="polite" data-course-bank-status>
    Loading course notes…
  </p>

  <div class="load-notice" data-course-bank-notice hidden>
    <p data-course-bank-notice-text></p>
    <button type="button" data-course-bank-retry>Retry</button>
  </div>

  <div class="course-bank-content" data-course-bank-content></div>
</section>

<script>
  import { initCourseBanks } from "../../scripts/course-bank/index";

  initCourseBanks();
</script>
