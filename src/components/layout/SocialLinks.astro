---
import { socialLinks } from "../../data/social-links";
import { localAssets } from "../../data/local-assets";

const sprite = localAssets.siteIcons;
---

<ul class="social-links" role="list">
  {
    socialLinks.map((link) => (
      <li>
        <a
          href={link.href}
          aria-label={link.name}
          target={link.newTab ? "_blank" : undefined}
          rel={link.newTab ? "noopener noreferrer" : undefined}
        >
          <svg aria-hidden="true" viewBox="0 0 417 417">
            <use href={`${sprite}#${link.icon}`} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-links {
    display: flex;
    justify-content: space-between;
    height: 49.5px;
    width: 442.6px;
    max-width: 100%;
    margin: 0 50px 0 0;
    padding: 0;
    list-style: none;
  }

  .social-links li {
    height: 100%;
    aspect-ratio: 1;
    flex: 0 0 auto;
  }

  .social-links a {
    display: block;
    height: 100%;
    color: black;
  }

  .social-links svg {
    height: 100%;
    width: 100%;
    fill: currentColor;
    opacity: 0.6;
  }

  .social-links a:hover svg {
    color: white;
    opacity: 0.95;
  }

  @media (max-width: 767px) {
    .social-links {
      margin-right: 20px;
    }
  }

  @media (max-width: 479px) {
    .social-links {
      height: 42.5px;
      width: auto;
      gap: 10px;
    }
  }
</style>
