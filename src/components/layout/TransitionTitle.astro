---
interface Props {
  text: string;
  id?: string;
}

const { text, id }: Props = Astro.props;
const parts = text.split(/(\s+)/u).filter(Boolean);
const labelId = "page-title-label";
---

<span id={labelId} class="visually-hidden" data-transition-title-label>
  {text}
</span>
<h1 id={id} data-transition-title aria-labelledby={labelId}>
  {
    parts.map((part) =>
      /^\s+$/u.test(part) ? (
        part
      ) : (
        <span class="transition-title-word" aria-hidden="true">
          {Array.from(part).map((character) => (
            <span class="transition-title-character" data-transition-character>
              {character}
            </span>
          ))}
        </span>
      ),
    )
  }
</h1>
