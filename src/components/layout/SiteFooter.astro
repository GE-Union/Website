---
import SocialLinks from "./SocialLinks.astro";
import { localAssets } from "../../data/local-assets";
---

<footer class="site-footer icon-background">
  <div class="footer-inner">
    <a href="/" class="footer-logo" aria-label="GE Union — home">
      <svg aria-hidden="true" viewBox="0 0 256 238">
        <use href={`${localAssets.siteIcons}#geu`}></use>
      </svg>
    </a>
    <SocialLinks />
  </div>
</footer>

<style>
  .site-footer {
    height: 200px;
    margin: var(--gap1);
    padding: 30px;
    border-radius: var(--rad1);
    overflow: hidden;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    max-width: 1500px;
    margin: 0 auto;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: fit-content;
    height: 100%;
    margin-right: auto;
    align-self: center;
    transition: scale 0.2s ease;
  }

  .footer-logo:hover {
    scale: 1.05;
  }

  .footer-logo svg {
    height: 100%;
    width: auto;
    aspect-ratio: 1.1;
    fill: white;
  }

  @media (max-width: 991px) {
    .footer-inner {
      gap: 80px;
    }
  }

  @media (max-width: 767px) {
    .site-footer {
      height: 160px;
    }

    .footer-inner {
      gap: 33px;
    }
  }

  @media (max-width: 479px) {
    .site-footer {
      height: 122px;
      padding: 15px;
    }

    .footer-logo {
      height: 78%;
      align-self: center;
    }
  }
</style>
